# Banco de dados (Postgres isolado do ItaGame — nunca a mesma instância do CEITEC ID System)
# Local (docker-compose.dev.yml expõe a porta 5433): host = localhost
# VPS (docker-compose.yml, rede itagame_network): host = itagame_db
#
# IMPORTANTE: não usar aspas nos valores. O `env_file` do Docker Compose não
# remove aspas como um shell faria — "postgresql://..." vira literalmente
# parte da string e quebra a conexão (erro P1013 "scheme is not recognized").
DATABASE_URL=postgresql://itagame:mude_esta_senha@localhost:5433/itagame?schema=public
POSTGRES_PASSWORD=mude_esta_senha

# Sessão (auth própria do ItaGame — gerar com: openssl rand -base64 32)
SESSION_SECRET=mude_este_valor_gerado_com_openssl_rand

# IA — geração de atividades e correção de redação
ANTHROPIC_API_KEY=

# Mercado Pago (assinatura do ItaGame)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# URL pública da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
