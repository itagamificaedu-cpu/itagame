// Schema inicial do ItaGame — banco isolado (nenhuma tabela/FK compartilhada com o CEITEC ID System)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ita_owner
  escola_admin
  professor
  aluno
}

enum PlanoAssinatura {
  gratis
  pro
}

enum StatusAssinatura {
  ativa
  atrasada
  cancelada
}

enum TipoAtividade {
  quiz
  verdadeiro_falso
  completar_frase
  caca_palavras
  associar_colunas
  apresentacao
  cabo_de_guerra
}

enum StatusSala {
  aberta
  em_andamento
  encerrada
}

enum TipoEstruturaTrilha {
  linear
  livre
}

enum StatusTrilha {
  rascunho
  publicada
}

enum TipoAtividadeMissao {
  video
  quiz
  pratica
  projeto
  leitura
  desafio
}

enum CheckpointTipo {
  quiz_automatico
  correcao_professor
  avaliacao_pratica
  banca
}

enum StatusProgressoMissao {
  bloqueada
  disponivel
  em_andamento
  concluida
}

model Escola {
  id          String   @id @default(cuid())
  nome        String
  criadaEm    DateTime @default(now())

  usuarios    Usuario[]
  assinatura  Assinatura?

  @@map("escolas")
}

model Usuario {
  id           String       @id @default(cuid())
  nome         String
  email        String       @unique
  senhaHash    String
  papel        PapelUsuario
  avatarUrl    String?
  criadoEm     DateTime     @default(now())

  // Segurança de sessão: só um aparelho logado por vez. A cada login (ou
  // acesso cortesia) sessaoAtual ganha um novo valor e vai carimbado no
  // cookie — se o carimbo do cookie não bater mais com esse aqui, é porque
  // a conta foi acessada em outro lugar depois, e aquele acesso é derrubado.
  sessaoAtual    String?
  ultimoAcessoEm DateTime?

  // Bloqueio de força bruta no login: a cada senha errada soma 1; ao bater o
  // limite, tranca por um tempo e zera o contador. Zera sozinho no próximo
  // login correto.
  tentativasLoginFalhas Int       @default(0)
  loginBloqueadoAte     DateTime?

  escolaId     String?
  escola       Escola?      @relation(fields: [escolaId], references: [id])

  turmasComoProfessor Turma[]        @relation("ProfessorTurmas")
  matriculas          Matricula[]
  atividadesCriadas   Atividade[]
  correcoesRedacao    CorrecaoRedacao[]
  missoesCriadas      Missao[]
  assinaturaProfessor Assinatura?    @relation("AssinaturaProfessor")
  salasCaboGuerra     SalaCaboGuerra[]
  salasJogoExterno    SalaJogoExterno[]
  trilhasCriadas      Trilha[]       @relation("TrilhasCriadas")
  progressosAvaliados ProgressoAluno[]

  @@map("usuarios")
}

model Turma {
  id           String   @id @default(cuid())
  nome         String
  serie        String
  // Código fixo (não expira, diferente do código de sala ao vivo) que o
  // aluno usa junto com o PIN pra acessar as trilhas da turma sem precisar
  // de e-mail/conta.
  codigoAcesso String?  @unique
  criadaEm     DateTime @default(now())

  professorId  String
  professor    Usuario  @relation("ProfessorTurmas", fields: [professorId], references: [id])

  matriculas   Matricula[]
  aplicacoes   AplicacaoAtividade[]
  alunos       Aluno[]
  trilhas      Trilha[]
  itensLoja    ItemLoja[]

  @@map("turmas")
}

model Aluno {
  id        String   @id @default(cuid())
  nome      String
  // PIN de 4 dígitos (hash bcrypt, igual senha de professor) — só o aluno
  // usa, junto com o código da turma, pra entrar em /entrar-trilha sem
  // precisar de e-mail. Nulo até o professor gerar o primeiro PIN.
  pinHash   String?
  criadoEm  DateTime @default(now())

  // Bloqueio de força bruta no PIN: mesmo esquema do login do professor —
  // conta erros, tranca por um tempo ao bater o limite, zera no PIN certo.
  tentativasPinFalhas Int       @default(0)
  pinBloqueadoAte     DateTime?

  turmaId   String
  turma     Turma    @relation(fields: [turmaId], references: [id])

  progressos       ProgressoAluno[]
  xpTransacoes     XpTransacao[]
  resgates         ResgateLoja[]
  badgesConcedidas BadgeConcedida[]

  @@map("alunos")
}

model Matricula {
  id        String   @id @default(cuid())
  turmaId   String
  alunoId   String
  criadaEm  DateTime @default(now())

  turma     Turma    @relation(fields: [turmaId], references: [id])
  aluno     Usuario  @relation(fields: [alunoId], references: [id])

  @@unique([turmaId, alunoId])
  @@map("matriculas")
}

model Atividade {
  id                String        @id @default(cuid())
  tipo              TipoAtividade
  disciplina        String
  serie             String
  tema              String
  conteudoGerado    Json
  gabarito          Json
  competenciasBncc  String[]
  criadaEm          DateTime      @default(now())

  professorId       String
  professor         Usuario       @relation(fields: [professorId], references: [id])

  aplicacoes        AplicacaoAtividade[]
  salasAoVivo       SalaAoVivo[]

  @@map("atividades")
}

model AplicacaoAtividade {
  id           String      @id @default(cuid())
  atividadeId  String
  turmaId      String
  aplicadaEm   DateTime    @default(now())

  atividade    Atividade   @relation(fields: [atividadeId], references: [id])
  turma        Turma       @relation(fields: [turmaId], references: [id])

  respostas    RespostaAluno[]

  @@map("aplicacoes_atividade")
}

model SalaAoVivo {
  id                String     @id @default(cuid())
  codigo            String     @unique
  status            StatusSala @default(aberta)
  perguntaAtual     Int        @default(-1)
  perguntaComecouEm DateTime?
  criadaEm          DateTime   @default(now())

  atividadeId       String
  atividade         Atividade  @relation(fields: [atividadeId], references: [id])

  participantes     ParticipanteSala[]

  @@map("salas_ao_vivo")
}

model ParticipanteSala {
  id          String   @id @default(cuid())
  apelido     String
  pontuacao   Int      @default(0)
  entrouEm    DateTime @default(now())

  salaId      String
  sala        SalaAoVivo @relation(fields: [salaId], references: [id])

  respostas   RespostaParticipante[]

  @@unique([salaId, apelido])
  @@map("participantes_sala")
}

model RespostaParticipante {
  id             String   @id @default(cuid())
  indiceQuestao  Int
  correta        Boolean
  pontosGanhos   Int
  respondidaEm   DateTime @default(now())

  participanteId String
  participante   ParticipanteSala @relation(fields: [participanteId], references: [id])

  @@unique([participanteId, indiceQuestao])
  @@map("respostas_participante")
}

model RespostaAluno {
  id             String   @id @default(cuid())
  aplicacaoId    String
  alunoId        String
  respostas      Json
  pontuacao      Int
  respondidaEm   DateTime @default(now())

  aplicacao      AplicacaoAtividade @relation(fields: [aplicacaoId], references: [id])

  @@map("respostas_aluno")
}

model CorrecaoRedacao {
  id               String   @id @default(cuid())
  tema             String
  textoEnviado     String
  notaGeral        Float
  feedbackGeral    String
  notasPorCriterio Json
  criadaEm         DateTime @default(now())

  professorId      String
  professor        Usuario  @relation(fields: [professorId], references: [id])

  @@map("correcoes_redacao")
}

model XpTransacao {
  id          String   @id @default(cuid())
  alunoId     String
  origem      String
  quantidade  Int
  criadaEm    DateTime @default(now())

  aluno       Aluno    @relation(fields: [alunoId], references: [id])

  @@map("xp_transacoes")
}

model Trilha {
  id            String              @id @default(cuid())
  nome          String
  descricao     String
  tipoEstrutura TipoEstruturaTrilha @default(linear)
  nivel         String
  status        StatusTrilha        @default(rascunho)
  // Preenchido quando a trilha é gerada com IA (BNCC Computação) — mesmo
  // padrão do campo competenciasBncc de Atividade.
  competenciasBncc String[]         @default([])
  criadaEm      DateTime            @default(now())
  atualizadaEm  DateTime            @updatedAt

  professorId   String
  professor     Usuario             @relation("TrilhasCriadas", fields: [professorId], references: [id])

  turmaId       String
  turma         Turma               @relation(fields: [turmaId], references: [id])

  missoes       Missao[]

  @@map("trilhas")
}

model Badge {
  id         String   @id @default(cuid())
  nome       String
  descricao  String
  icone      String   @default("🏅")
  criadaEm   DateTime @default(now())

  missoes    Missao[]
  concedidas BadgeConcedida[]

  @@map("badges")
}

model Missao {
  id             String   @id @default(cuid())
  titulo         String
  descricao      String
  xpRecompensa   Int
  criadaEm       DateTime @default(now())

  criadaPorId    String
  criadaPor      Usuario  @relation(fields: [criadaPorId], references: [id])

  // --- campos de trilha (Missao sem trilhaId fica "avulsa", sem sequência) ---
  trilhaId            String?
  trilha              Trilha?             @relation(fields: [trilhaId], references: [id])
  ordem               Int                 @default(0)
  tipoAtividade       TipoAtividadeMissao @default(desafio)
  nivelDificuldade    String?
  preRequisitoId      String?
  preRequisito        Missao?             @relation("PreRequisitoMissao", fields: [preRequisitoId], references: [id])
  desbloqueiaMissoes  Missao[]            @relation("PreRequisitoMissao")
  criterioDesbloqueio String?
  badgeId             String?
  badge               Badge?              @relation(fields: [badgeId], references: [id])
  checkpointTipo      CheckpointTipo      @default(correcao_professor)
  notaMinima          Int?
  // Perguntas do quiz automático: [{ enunciado, alternativas, respostaCorreta }]
  // — mesmo formato usado nas atividades geradas por IA. Só é lido quando
  // checkpointTipo = quiz_automatico.
  quizPerguntas       Json?

  progressos          ProgressoAluno[]

  @@map("missoes")
}

model ProgressoAluno {
  id            String                @id @default(cuid())
  alunoId       String
  aluno         Aluno                 @relation(fields: [alunoId], references: [id])
  missaoId      String
  missao        Missao                @relation(fields: [missaoId], references: [id])
  status        StatusProgressoMissao @default(bloqueada)
  xpGanho       Int                   @default(0)
  entregaTexto  String?
  feedbackProfessor String?
  concluidaEm   DateTime?
  avaliadoPorId String?
  avaliadoPor   Usuario?              @relation(fields: [avaliadoPorId], references: [id])
  atualizadoEm  DateTime              @updatedAt

  @@unique([alunoId, missaoId])
  @@map("progresso_alunos")
}

model BadgeConcedida {
  id          String   @id @default(cuid())
  alunoId     String
  aluno       Aluno    @relation(fields: [alunoId], references: [id])
  badgeId     String
  badge       Badge    @relation(fields: [badgeId], references: [id])
  concedidaEm DateTime @default(now())

  @@unique([alunoId, badgeId])
  @@map("badges_concedidas")
}

enum StatusResgate {
  pendente
  entregue
  cancelado
}

// Loja de recompensas — o professor cadastra prêmios (físicos ou digitais)
// que os alunos da turma resgatam trocando o XP acumulado nas trilhas.
model ItemLoja {
  id         String   @id @default(cuid())
  nome       String
  descricao  String?
  custoXp    Int
  icone      String   @default("🎁")
  estoque    Int?
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())

  turmaId    String
  turma      Turma    @relation(fields: [turmaId], references: [id])

  resgates   ResgateLoja[]

  @@map("itens_loja")
}

model ResgateLoja {
  id          String        @id @default(cuid())
  alunoId     String
  itemId      String
  // Custo no momento do resgate — preservado mesmo que o professor mude o
  // preço do item depois (não reescreve o histórico).
  custoXp     Int
  status      StatusResgate @default(pendente)
  resgatadoEm DateTime      @default(now())
  entregueEm  DateTime?

  aluno       Aluno    @relation(fields: [alunoId], references: [id])
  item        ItemLoja @relation(fields: [itemId], references: [id])

  @@map("resgates_loja")
}

model Assinatura {
  id              String            @id @default(cuid())
  plano           PlanoAssinatura   @default(gratis)
  status          StatusAssinatura  @default(ativa)
  mercadoPagoId   String?
  validade        DateTime?
  criadaEm        DateTime          @default(now())
  // true = liberada de graça (acesso cortesia do Desafio Prof Conectado),
  // não uma assinatura paga de verdade. Vira false automaticamente quando
  // o professor paga pelo Mercado Pago. Usada pra limitar o cortesia a 1
  // atividade gerada por tipo, sem afetar quem já é assinante.
  cortesia        Boolean           @default(false)

  escolaId        String?           @unique
  escola          Escola?           @relation(fields: [escolaId], references: [id])

  professorId     String?           @unique
  professor       Usuario?          @relation("AssinaturaProfessor", fields: [professorId], references: [id])

  @@map("assinaturas")
}

enum StatusSalaCaboGuerra {
  aberta
  em_andamento
  encerrada
}

model SalaCaboGuerra {
  id                String               @id @default(cuid())
  codigo            String               @unique
  status            StatusSalaCaboGuerra @default(aberta)
  nomeEquipe1       String
  nomeEquipe2       String
  rodadaAtual       Int                  @default(1)
  totalRodadas      Int                  @default(15)
  perguntaTexto     String?
  perguntaResposta  Int?
  perguntaAlternativas Json?
  perguntaComecouEm DateTime?
  rodadaGanhaPor    Int?
  rodadaTerminouEm  DateTime?
  pontosEquipe1     Int                  @default(0)
  pontosEquipe2     Int                  @default(0)
  perguntas         Json?
  criadaEm          DateTime             @default(now())

  professorId       String
  professor         Usuario              @relation(fields: [professorId], references: [id])

  participantes     ParticipanteCaboGuerra[]

  @@map("salas_cabo_guerra")
}

model ParticipanteCaboGuerra {
  id        String   @id @default(cuid())
  apelido   String
  equipe    Int
  pontuacao Int      @default(0)
  entrouEm  DateTime @default(now())

  salaId    String
  sala      SalaCaboGuerra @relation(fields: [salaId], references: [id])

  @@unique([salaId, apelido])
  @@map("participantes_cabo_guerra")
}

// Salas para jogos externos ao Next.js (ex: exports HTML5 do Construct 2, hospedados
// em outra origem/domínio). O aluno não faz login — entra com apelido + código da sala,
// igual ao Cabo de Guerra, e recebe um token assinado (não cookie, porque o jogo roda
// em outra origem) que usa pra mandar o resultado final quando a partida acaba.
model SalaJogoExterno {
  id          String     @id @default(cuid())
  codigo      String     @unique
  jogo        String     // slug do jogo, ex: "ita3climas"
  status      StatusSala @default(aberta)
  criadaEm    DateTime   @default(now())

  professorId String
  professor   Usuario    @relation(fields: [professorId], references: [id])

  participantes ParticipanteJogoExterno[]

  @@map("salas_jogo_externo")
}

model ParticipanteJogoExterno {
  id            String    @id @default(cuid())
  apelido       String
  pontuacao     Int       @default(0)
  tempoSegundos Int?
  respostas     Json?
  // Print da tela do jogo no momento em que o aluno informou a pontuação (base64,
  // capturado do <canvas> pelo itagame-integracao.js). O aluno digita a pontuação
  // (não dá pra ler automaticamente do jogo compilado — sem o .capx fonte não dá pra
  // saber com certeza onde fica essa variável), então essa imagem é a forma do
  // professor conferir se bate, sem confiar cegamente no número digitado.
  capturaTela   String?   @db.Text
  entrouEm      DateTime  @default(now())
  finalizadoEm  DateTime?

  salaId        String
  sala          SalaJogoExterno @relation(fields: [salaId], references: [id])

  @@unique([salaId, apelido])
  @@map("participantes_jogo_externo")
}
